+
+// BlockDeadline returns the deadline the task is blocked until and true,
+// while it is blocked with one; false otherwise. The deadline is on the clock
+// the task blocked on, so the wait is deadline minus that clock's Now.
+func (t *Task) BlockDeadline() (ktime.Time, ktime.Clock, bool) {
+	t.blockDeadlineMu.Lock()
+	defer t.blockDeadlineMu.Unlock()
+	return t.blockDeadline, t.blockDeadlineClock, t.blockDeadlineClock != nil
+}
