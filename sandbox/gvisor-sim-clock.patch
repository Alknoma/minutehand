+// AdvanceClock moves the sandbox's realtime clock by ns, and its monotonic
+// clock too when ns is positive (monotonic never goes backwards: a step back
+// is a sandbox born before now), publishes the new parameters to the VDSO,
+// and tells every timer on either clock that the clock was set, so an armed
+// sleep, futex, poll or epoll timeout re-checks its deadline at once.
+func (t *Timekeeper) AdvanceClock(ns int64) {
+	t.simRealtime.Add(ns)
+	if ns > 0 {
+		t.simMonotonic.Add(ns)
+	}
+	t.updateMu.Lock()
+	if t.clocks != nil && t.params != nil {
+		t.update(false)
+	}
+	t.updateMu.Unlock()
+	t.realtimeClock.Notify(ktime.ClockEventSet)
+	t.monotonicClock.Notify(ktime.ClockEventSet)
+	if t.monotonicRawClock != nil {
+		t.monotonicRawClock.Notify(ktime.ClockEventSet)
+	}
+	if t.afterFuncSchedulerWakeCh != nil {
+		select {
+		case t.afterFuncSchedulerWakeCh <- struct{}{}:
+		default:
+		}
+	}
+}
+
+// SimOffset is how far AdvanceClock has moved the sandbox's realtime clock in all.
+func (t *Timekeeper) SimOffset() int64 {
+	return t.simRealtime.Load()
+}
