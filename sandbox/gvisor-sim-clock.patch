+package kernel
+
+import (
+	sentrytime "gvisor.dev/gvisor/pkg/sentry/time"
+)
+
+// TaskWait is one blocked task's deadline, as the time until it, on the clock
+// it blocked on.
+type TaskWait struct {
+	Task int32
+	Ns   int64
+}
+
+// Deadlines is what an outside controller reads to know when the sandbox
+// next wants to run by itself: whether every task is blocked, the sandbox's
+// realtime clock, and how long until each blocked task's deadline.
+type Deadlines struct {
+	// Idle is true when no task goroutine is running or runnable.
+	Idle bool
+	// Held is true while the sandbox's clock is held (HoldClock).
+	Held bool
+	// NowNs is the sandbox's CLOCK_REALTIME, nanoseconds since the epoch.
+	NowNs int64
+	// Tasks is how many tasks there are.
+	Tasks int
+	// Timed is how many of them are blocked with a deadline.
+	Timed int
+	// EarliestNs is the time until the earliest deadline any blocked task
+	// waits for; -1 when none does.
+	EarliestNs int64
+	// Waits is every blocked task's deadline.
+	Waits []TaskWait
+}
+
+// Deadlines reports every task's blocking deadline and whether the sandbox is
+// idle. It takes no lock that stops the tasks: a task that wakes while it is
+// read shows in Idle on the next read.
+func (k *Kernel) Deadlines() (Deadlines, error) {
+	now, err := k.timekeeper.GetTime(sentrytime.Realtime)
+	if err != nil {
+		return Deadlines{}, err
+	}
+	report := Deadlines{Idle: k.runningTasks.Load() == 0, Held: k.timekeeper.ClockHeld(), NowNs: now, EarliestNs: -1}
+	for _, t := range k.tasks.Root.Tasks() {
+		report.Tasks++
+		deadline, clock, ok := t.BlockDeadline()
+		if !ok {
+			continue
+		}
+		until := deadline.Sub(clock.Now()).Nanoseconds()
+		if until < 0 {
+			until = 0
+		}
+		report.Timed++
+		report.Waits = append(report.Waits, TaskWait{Task: int32(k.tasks.Root.IDOfTask(t)), Ns: until})
+		if report.EarliestNs < 0 || until < report.EarliestNs {
+			report.EarliestNs = until
+		}
+	}
+	return report, nil
+}
+
+// AdvanceClock moves the sandbox's clocks by ns (Timekeeper.AdvanceClock).
+func (k *Kernel) AdvanceClock(ns int64) {
+	k.timekeeper.AdvanceClock(ns)
+}
+
+// HoldClock holds the sandbox's clocks at their current value when hold is
+// true (Timekeeper.HoldClock), and lets them run on from it when false
+// (Timekeeper.ReleaseClock).
+func (k *Kernel) HoldClock(hold bool) error {
+	if hold {
+		return k.timekeeper.HoldClock()
+	}
+	return k.timekeeper.ReleaseClock()
+}
