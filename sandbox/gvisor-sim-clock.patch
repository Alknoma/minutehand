+	}
+	*out = sentryapi.Deadlines{
+		Idle:       found.Idle,
+		NowNs:      found.NowNs,
+		Tasks:      found.Tasks,
+		Timed:      found.Timed,
+		EarliestNs: found.EarliestNs,
+		Waits:      waits,
+	}
+	return nil
+}
+
+// AdvanceClock moves the sandbox's clocks by the signed step given.
+func (d *debug) AdvanceClock(args *sentryapi.AdvanceClockArgs, _ *struct{}) error {
+	d.k.AdvanceClock(args.Nanoseconds)
+	return nil
+}
