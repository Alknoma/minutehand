+// HoldClock stops the application's realtime and monotonic clocks at their
+// current value until ReleaseClock: every read returns that value, on the
+// syscall path and through the VDSO, and no sleep, futex, poll, epoll or
+// timer deadline on them passes. Holding a held clock does nothing.
+func (t *Timekeeper) HoldClock() error {
+	t.holdMu.Lock()
+	defer t.holdMu.Unlock()
+	if t.held.Load() {
+		return nil
+	}
+	// Send the VDSO to the syscall path first, so no read it answers from
+	// its parameters can land past the value held.
+	t.publishVDSO(vdsoSyscall)
+	realtime, err := t.GetTime(sentrytime.Realtime)
+	if err != nil {
+		return err
+	}
+	monotonic, err := t.GetTime(sentrytime.Monotonic)
+	if err != nil {
+		return err
+	}
+	t.heldRealtime.Store(realtime)
+	t.heldMonotonic.Store(monotonic)
+	t.held.Store(true)
+	t.publishVDSO(vdsoHeld)
+	return nil
+}
+
+// ReleaseClock lets the application's clocks run again from the value they
+// were held at: the time they were held for is taken off every later read,
+// so none of it passed for the application. Every timer on them re-arms on
+// the released clock. Releasing a clock not held does nothing.
+func (t *Timekeeper) ReleaseClock() error {
+	t.holdMu.Lock()
+	defer t.holdMu.Unlock()
+	if !t.held.Load() {
+		return nil
+	}
+	// Through the syscall path again, so no read the VDSO answers from the
+	// held parameters lands after one GetTime answers on the released clock.
+	t.publishVDSO(vdsoSyscall)
+	realtime, err := t.machineTime(sentrytime.Realtime)
+	if err != nil {
+		return err
+	}
+	monotonic, err := t.machineTime(sentrytime.Monotonic)
+	if err != nil {
+		return err
+	}
+	heldMonotonic := t.heldMonotonic.Load()
+	if lowerBound := t.appMonotonicLowerBound.Load(); lowerBound > heldMonotonic {
+		heldMonotonic = lowerBound
+	}
+	t.holdRealtime.Store(realtime - t.heldRealtime.Load())
+	t.holdMonotonic.Store(monotonic - heldMonotonic)
+	t.held.Store(false)
+	t.publishVDSO(vdsoLive)
+	t.realtimeClock.Notify(ktime.ClockEventSet)
+	t.monotonicClock.Notify(ktime.ClockEventSet)
+	return nil
+}
+
+// publishVDSO sets what the VDSO parameters publish and publishes them.
+func (t *Timekeeper) publishVDSO(mode int) {
