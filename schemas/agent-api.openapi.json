{
  "components": {
    "schemas": {
      "Decider": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "key",
          "email",
          "name"
        ],
        "title": "Decider",
        "type": "object"
      },
      "DecisionMade": {
        "additionalProperties": false,
        "description": "The default shape of `decide`'s request body: who decided what on which item, and what they gave.",
        "properties": {
          "decided_at": {
            "description": "The simulated moment, ISO 8601",
            "title": "Decided At",
            "type": "string"
          },
          "decision": {
            "title": "Decision",
            "type": "string"
          },
          "inputs": {
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "title": "Inputs",
            "type": "object"
          },
          "item": {
            "description": "The item's own id",
            "title": "Item",
            "type": "string"
          },
          "person": {
            "$ref": "#/components/schemas/Decider"
          }
        },
        "required": [
          "item",
          "decision",
          "person",
          "decided_at"
        ],
        "title": "DecisionMade",
        "type": "object"
      },
      "DeliveredReply": {
        "additionalProperties": false,
        "description": "The default shape of a person's answer delivered to the agent's inbound webhook (`ReplyDelivery.body` None).",
        "properties": {
          "from": {
            "description": "The email of the person who answers",
            "title": "From",
            "type": "string"
          },
          "from_name": {
            "description": "Their name",
            "title": "From Name",
            "type": "string"
          },
          "in_reply_to": {
            "description": "The id of the send it answers (`ReplyDelivery.thread`)",
            "title": "In Reply To",
            "type": "string"
          },
          "reply_id": {
            "description": "The reply's own id in the run",
            "title": "Reply Id",
            "type": "string"
          },
          "sent_at": {
            "description": "The simulated moment it is sent, ISO 8601",
            "title": "Sent At",
            "type": "string"
          },
          "subject": {
            "description": "'Re: ' and the send's subject; empty when it had none",
            "title": "Subject",
            "type": "string"
          },
          "text": {
            "description": "What they wrote",
            "title": "Text",
            "type": "string"
          },
          "to": {
            "description": "The address the agent sent from, else the first it wrote to",
            "title": "To",
            "type": "string"
          }
        },
        "required": [
          "reply_id",
          "from",
          "from_name",
          "to",
          "subject",
          "text",
          "in_reply_to",
          "sent_at"
        ],
        "title": "DeliveredReply",
        "type": "object"
      },
      "PendingItem": {
        "additionalProperties": false,
        "description": "One item in the default shape of a list: what `listPending` answers each item as.",
        "properties": {
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Category"
          },
          "decisions": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The decisions allowed on it; None: every one",
            "title": "Decisions"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "waits_on": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The email of whom it waits on, for a list of everyone's",
            "title": "Waits On"
          }
        },
        "required": [
          "id",
          "summary"
        ],
        "title": "PendingItem",
        "type": "object"
      },
      "PendingPage": {
        "additionalProperties": false,
        "description": "The default shape of `listPending`'s answer: one page of what waits on the person asked for.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PendingItem"
            },
            "title": "Items",
            "type": "array"
          },
          "next": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The cursor of the next page; None on the last",
            "title": "Next"
          }
        },
        "required": [
          "items"
        ],
        "title": "PendingPage",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Every operation is optional. The agent file names the URL of each one it implements.",
    "title": "What an agent may implement for Minutehand",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/inboxes/{inbox}/items/{item}/decision": {
      "post": {
        "operationId": "decide",
        "parameters": [
          {
            "description": "The inbox's name in the agent file",
            "in": "path",
            "name": "inbox",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The item's own id",
            "in": "path",
            "name": "item",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionMade"
              }
            }
          },
          "required": true
        },
        "responses": {
          "2XX": {
            "description": "The decision was taken; any other status is the product refusing it"
          }
        },
        "summary": "A person decides one item"
      }
    },
    "/inboxes/{inbox}/pending": {
      "get": {
        "operationId": "listPending",
        "parameters": [
          {
            "description": "The inbox's name in the agent file",
            "in": "path",
            "name": "inbox",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The email of the person whose items are asked for",
            "in": "query",
            "name": "person",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The `next` of the page before; absent for the first",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PendingPage"
                }
              }
            },
            "description": "One page of items"
          }
        },
        "summary": "What waits on one person in the agent's own product, a page at a time"
      }
    },
    "/replies": {
      "post": {
        "operationId": "deliverReply",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeliveredReply"
              }
            }
          },
          "required": true
        },
        "responses": {
          "2XX": {
            "description": "The reply was taken"
          }
        },
        "summary": "A person's answer to one of the agent's captured sends, in the default shape"
      }
    }
  },
  "servers": [
    {
      "description": "Wherever the agent listens",
      "url": "http://127.0.0.1:8790"
    }
  ]
}
