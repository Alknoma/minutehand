# The example agent's own environment (docs/agent-environment.md), read by Minutehand when it starts
# `run_in_sandbox.sh`, as `agent.yaml` declares. The fake Slack accepts any token, so this one is a placeholder in
# the shape of a bot token; a real agent's file holds its real token and is kept out of version control.
AGENT_SLACK_TOKEN=xoxb-proactive-agent-example-token
AGENT_PORT=8740
